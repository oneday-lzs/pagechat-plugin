{
  "manifest_version": 3,
  "name": "PageChat – AI Webpage Summarizer",
  "short_name": "PageChat",
  "description": "Summarize any webpage or whole site, chat about the tab, extract company info, and translate selections. Ready to use — no API key setup.",
  "version": "1.4.0",
  "homepage_url": "https://pagechat-plugin-tvkj.vercel.app/",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open PageChat",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "ui/sidepanel.html"
  },
  "options_page": "ui/options.html",
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Y",
        "mac": "Alt+Y"
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
